# Compose interpolation values. Copy to .env (ignored by Git) and set real secrets.
# scripts/postiz-local.mjs setup generates this file with random passwords.
POSTIZ_DB_USER=postiz
POSTIZ_DB_NAME=postiz
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# Address and port that expose the Postiz web/API entry point (nginx on 5000 inside).
# Keep 127.0.0.1 locally. On a server, keep it loopback and put a TLS reverse proxy in front.
POSTIZ_BIND=127.0.0.1
POSTIZ_PORT=4007
TEMPORAL_UI_PORT=8080

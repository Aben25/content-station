# Postiz application settings. Copy to postiz.env (ignored by Git).
# Reference: https://docs.postiz.com/self-host/configuration/reference

# Public URLs. FRONTEND_URL is also the OAuth redirect base:
#   {FRONTEND_URL}/integrations/social/{provider}
# and the base of uploaded media URLs ({FRONTEND_URL}/uploads/...), which social
# platforms fetch. It must be reachable by browsers and by Meta's servers.
MAIN_URL=http://127.0.0.1:4007
FRONTEND_URL=http://127.0.0.1:4007
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4007/api

# Signs Postiz sessions and the enterprise provisioning/connect payloads that the
# ContentStation API sends. At least 32 random characters. Share only with the API.
JWT_SECRET=

# Only the first registration is allowed once this is true; shop organizations
# are created by the ContentStation API through /enterprise/create-user.
DISABLE_REGISTRATION=true

# Global per-hour request budget applied per client IP across the backend.
# The ContentStation API polls from a single egress address, so keep this high.
API_LIMIT=5000

# Local development only: allow the SSRF guard to call loopback/private addresses
# (the ContentStation API at 127.0.0.1) and issue non-secure cookies over http.
# Never set these on the hosted instance.
DISABLE_SSRF_PROTECTION=true
NOT_SECURED=true

# Meta developer app credentials. Facebook Pages and Facebook-linked Instagram
# share one app. Leave empty until the app exists; the providers stay hidden.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Unused features are left unset on purpose: no OpenAI, Stripe, email provider,
# short links, analytics or extra social providers.
OPENAI_API_KEY=

# Real owner app. The local API defaults to port 4310 in the integration workspace.
VITE_API_BASE_URL=http://127.0.0.1:4310
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional local Firebase Auth emulator, for example http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Sample data is never automatic. Set this explicitly to use the clickable demo.
VITE_DEMO_MODE=false

API_BASE_URL=http://127.0.0.1:4310
ENGINE_API_KEY=
# Absolute path to the pinned OpenShorts checkout created by setup-openshorts.sh.
OPENSHORTS_HOME=
OPENSHORTS_PYTHON=
ENGINE_WORK_DIR=.runtime/jobs
# local: motion heuristic + actual OpenShorts renderer, no paid model calls.
# ai: upstream analysis (including visual analysis for silent footage).
ENGINE_MODE=local
CLIP_SECONDS=30
GEMINI_API_KEY=

# Edge Function secrets. Set with: npx supabase secrets set --env-file supabase/.env
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected by the platform.

# Signs wall device JWTs. Long random string. Rotating it logs every camera out.
DEVICE_JWT_SECRET=
# Encrypts the Wi-Fi password while a pair token is live. Long random string.
PAIR_ENC_KEY=
# Shared secret for the minute tick from pg_cron.
CRON_SECRET=

# External clipping engine.
ENGINE_API_KEY=
ENGINE_WEBHOOK_URL=

# Twilio for owner texts. Leave empty for dry run (texts are logged in notifications, not sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=
TWILIO_FROM=

# Optional. Prefills recording hours from Google Places (New). Skip in v1 if unset.
GOOGLE_PLACES_API_KEY=

# Optional. Where "alert to us" texts go. Not used yet, ops alerts land in the notifications table.
OPS_ALERT_PHONE=

# Local emulators only. The launcher generates ignored local secrets.
GCLOUD_PROJECT=demo-contentstation-v2
# For an isolated named v2 database in a shared hosted project:
# FIRESTORE_DATABASE_ID=contentstation-v2
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-contentstation-v2.appspot.com
PORT=4310
HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:4310
OWNER_ORIGIN=http://127.0.0.1:4311,http://localhost:4311
DEVICE_JWT_SECRET=
MEDIA_SECRET=
ENGINE_API_KEY=
CRON_SECRET=
# disabled, dry-run, or live. dry-run never marks clips delivered.
SMS_MODE=disabled
# Live SMS configuration is optional and never used in local smoke.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=
# TWILIO_INBOUND_URL=

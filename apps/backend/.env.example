# Content Station backend environment — copy to .env and fill in.
# .env is gitignored. Never commit real tokens.

# --- Brand profile -------------------------------------------------------
BUSINESS_NAME=Demo Business
BUSINESS_CATEGORY=local business
BUSINESS_LOCATION=City, ST
BUSINESS_TIMEZONE=America/New_York
TARGET_AUDIENCE=local customers
BRAND_TONE=friendly and energetic
BRAND_COLOR="#FFFFFF"
DEFAULT_CTA=Come see us today!
PROHIBITED_CLAIMS=guaranteed results,medical advice

# --- Auth (required — the server refuses to start without these) ---------
# Generate with:
#   node -e 'console.log("cs_stn_"+require("crypto").randomBytes(24).toString("hex"))'
#   node -e 'console.log("cs_own_"+require("crypto").randomBytes(24).toString("hex"))'
# STATION_TOKEN goes in the iPhone app, OWNER_TOKEN in the dashboard server env.
STATION_TOKEN=
OWNER_TOKEN=
CORS_ORIGIN=http://localhost:3001

# --- Publishing ----------------------------------------------------------
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_IDS=

# --- Vision + culling ----------------------------------------------------
# Describe the footage before writing about it. Without this the content model
# only sees the transcript and invents when a clip is silent.
# VISION_ENABLED=true
# VISION_MODEL=stepfun/step-3.7-flash:free   # defaults to CONTENT_LLM_MODEL
# VISION_FRAMES=3
# Discard clips where nothing moves. Handheld ~0.013, a static frame ~0.000003.
# CULL_STATIC_CLIPS=true
# MOTION_THRESHOLD=0.0005
# Delete the raw upload once a branded render exists.
# DELETE_RAW_AFTER_RENDER=true

# --- Overrides (defaults are sensible for local dev) ---------------------
# CONTENT_LLM_BASE_URL=http://127.0.0.1:8645/v1
# CONTENT_LLM_API_KEY=content-station
CONTENT_LLM_MODEL=stepfun/step-3.7-flash:free
# RAW_RETENTION_DAYS=7
# WHISPER_CLI=./tools/whisper/whisper-cli
# WHISPER_MODEL=./tools/models/ggml-base.en.bin
